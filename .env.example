# URL of the Voltius backend API
ADMIN_API_URL=http://localhost:8080

# Set to "true" only when serving over HTTPS
COOKIE_SECURE=false

# Must match the X-Admin-Key the backend expects
ADMIN_SECRET=

# Comma-separated list of allowed admin emails
ADMIN_EMAILS=you@example.com

# Shared password for all admin accounts
ADMIN_PASSWORD=
